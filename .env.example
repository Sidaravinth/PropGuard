# Copy to .env and fill in.
# Free key from Google AI Studio (https://aistudio.google.com/apikey).
# Free-tier content may be used by Google to improve its products: use sample data only.
GEMINI_API_KEY=

# Model used for lease extraction (lightweight/fast model for bulk structured extraction).
EXTRACTION_MODEL=gemini-3.5-flash-lite
# LLM attempts per document before it is stored as needs_review.
EXTRACTION_MAX_ATTEMPTS=3

# Model for the AI agent (tool calling + Decision Brief drafting) and how much it "thinks"
# (MINIMAL | LOW | MEDIUM | HIGH; higher = slower and costlier).
AGENT_MODEL=gemini-3.5-flash-lite
AGENT_THINKING_LEVEL=LOW

# Time limit for one model request attempt, and retries for transient failures
# (timeouts, dropped connections, rate limits, server errors; never bad keys or bad requests).
AGENT_TIMEOUT_MS=60000
EXTRACTION_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Model for the grounded Q&A chat on the lease page. Defaults to AGENT_MODEL.
# Only the selected lease's matching excerpts are sent to it.
# QA_MODEL=gemini-3.5-flash-lite

# --- OCR (scanned PDFs and JPG/PNG images) ------------------------------------
# OCR runs on this server (tesseract.js, English model bundled), so page images are never sent
# anywhere. Set OCR_ENABLED=false to refuse scanned documents instead.
OCR_ENABLED=true
# Longest document accepted, in pages.
OCR_MAX_PAGES=50
# Time limit for recognising one page.
OCR_PAGE_TIMEOUT_MS=120000

# Automatic renewal briefs: scan at startup, then on this interval. Set to false to use the button only.
RENEWAL_AUTO_ENABLED=true
RENEWAL_SCAN_INTERVAL_MINUTES=60

PORT=3001
# Defaults to ./data/propguard.db
# DB_PATH=

# Pin "today" for reproducible demos/tests (expired leases, overdue months, notice windows).
# PROPGUARD_TODAY=2026-11-26

# --- Initial user accounts (Day 2) -------------------------------------------
# Used ONLY when the users table is empty (first start, or `npm run bootstrap-users`).
# Passwords: 12+ characters mixing at least three of lowercase/uppercase/digits/symbols.
# After the first start you can delete the two *_PASSWORD lines; change passwords in Settings.
PROPGUARD_PM_EMAIL=
PROPGUARD_PM_NAME=
PROPGUARD_PM_PASSWORD=
PROPGUARD_RD_EMAIL=
PROPGUARD_RD_NAME=
PROPGUARD_RD_PASSWORD=

# Sessions: absolute lifetime and idle timeout.
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
# bcrypt cost factor.
BCRYPT_ROUNDS=12
# Secure cookie flag (needs HTTPS). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# --- Storage (Day 2) ----------------------------------------------------------
# Where uploaded originals are kept. Defaults to ./data/uploads
# UPLOADS_DIR=
# Database written by `npm run seed` (sample data for development/evaluation). Defaults to ./data/propguard-sample.db
# It must differ from DB_PATH: seeding never touches the live database.
# SEED_DB_PATH=
